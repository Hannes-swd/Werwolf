{
  "name": "werwolf",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local": "E2E_LOCAL_REALTIME=1 NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:3102 NEXT_PUBLIC_SUPABASE_ANON_KEY=local-browser-test-key playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "lobby": "node scripts/start-lobby.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  },
  "overrides": {
    "postcss": "8.5.21",
    "sharp": "0.35.0"
  }
}
